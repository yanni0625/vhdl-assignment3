  <vhdl appearance="logisim_evolution" name="jkff">library ieee;
use ieee.std_logic_1164.all;

entity jkff is
    port (
        clk : in  std_logic;
        j   : in  std_logic;
        k   : in  std_logic;
        q   : out std_logic;
        qn  : out std_logic
    );
end entity jkff;

architecture behavioral of jkff is
    signal q_i : std_logic := '0';
begin
    process (clk)
    begin
        if rising_edge(clk) then
            if j = '0' and k = '0' then
                q_i &lt;= q_i;        -- Hold
            elsif j = '0' and k = '1' then
                q_i &lt;= '0';        -- Reset
            elsif j = '1' and k = '0' then
                q_i &lt;= '1';        -- Set
            else
                q_i &lt;= not q_i;    -- Toggle
            end if;
        end if;
    end process;

    q  &lt;= q_i;
    qn &lt;= not q_i;
end architecture behavioral;</vhdl>
